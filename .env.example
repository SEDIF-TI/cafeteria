# =========================================================================
# Plantilla de variables de entorno - backend (sistema_cafeteria)
# Copia este archivo como ".env" y rellena con los valores reales.
# El ".env" real NO se versiona (está en .gitignore).
# =========================================================================

# --- Base de datos PostgreSQL ---
DB_HOST=localhost
DB_PORT=5437
POSTGRES_DB=cafeteria
POSTGRES_USER=cafeteria_user
POSTGRES_PASSWORD=cambia_esta_contrasena

# --- Seguridad / JWT ---
# Cadena larga y aleatoria (mín. 32 caracteres). Genera una nueva por entorno.
APP_JWT_SECRET=cambia_esta_clave_secreta_larga_y_aleatoria
APP_JWT_EXPIRATION=3600000

# --- CORS (orígenes permitidos, separados por coma) ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Correo (Gmail SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@gmail.com
# Contraseña de aplicación de Gmail: 16 caracteres SIN espacios
MAIL_PASSWORD=contrasena_de_aplicacion_de_16_caracteres
