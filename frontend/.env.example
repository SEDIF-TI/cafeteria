# =========================================================================
# Plantilla de variables de entorno - frontend (Vite / React)
# Copia este archivo como ".env" y ajusta según el entorno.
# Si se dejan vacías, se usan los valores por defecto del código.
# =========================================================================

# URL base de la API. Si se omite, el frontend usa el proxy "/api/v1".
# Ejemplo para apuntar directo al backend:
# VITE_API_URL=http://192.168.1.50:8080/api/v1
VITE_API_URL=

# URL pública usada para generar el QR de registro de clientes.
# Si se omite, se usa la dirección desde la que se abre la app.
# Ejemplo:
# VITE_PUBLIC_URL=http://192.168.1.50:5173
VITE_PUBLIC_URL=
