# =========================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — sistema-tickets
# =========================================================================
# Copia este archivo como .env y sustituye los valores por los reales.
#
#   cp .env.example .env
#
# El archivo .env NUNCA se sube a git (esta en .gitignore).
# Este .env.example SI se versiona: solo contiene valores ficticios.
# =========================================================================

# --- Base de datos PostgreSQL ---
POSTGRES_DB=NOMBRE_DE_TU_BD
POSTGRES_USER=USUARIO_DE_TU_BD
POSTGRES_PASSWORD=ContraseñaSeguraQueNoVasAUsarEnProduccion

# Host y puerto vistos desde el backend cuando se ejecuta EN TU EQUIPO, que es
# el flujo de desarrollo habitual (extension de Spring Boot en VS Code).
#
# El contenedor de PostgreSQL publica el 5433 en el host para no chocar con un
# PostgreSQL instalado localmente, que suele ocupar el 5432. Apuntar al 5432
# desde fuera de Docker da "Connection refused".
#
# No hace falta cambiarlos para levantar todo con Docker Compose:
# docker-compose.yml define alli DB_HOST=postgres-db y DB_PORT=5432 por su
# cuenta, y esos valores tienen preferencia dentro del contenedor.
DB_HOST=localhost
DB_PORT=5433

# --- Seguridad / JWT ---
# Clave de firma HMAC-SHA256 en BASE64. Debe tener 256 bits (32 bytes) como minimo.
# Genera una nueva y unica por entorno con:
#   openssl rand -base64 32
# NUNCA reutilices la clave de otro proyecto ni la de ningun tutorial.
# JwtSecretValidator aborta el arranque si es debil o conocida.
APP_JWT_SECRET=FXAWrgiSA64/vg9JpFThfy0ixEboJ4hAEvEX1S9dLF0=

# Vigencia del access token en milisegundos (3600000 = 1 hora)
APP_JWT_EXPIRATION=3600000

# --- Bot de Telegram (notificaciones) ---
# Token que entrega @BotFather. Es una credencial: tratala como una password.
TELEGRAM_BOT_USERNAME=Bot_pruebasSEDIF_bot
# --- Frontend - Telegram ---
VITE_TELEGRAM_BOT_USERNAME=Bot_pruebasSEDIF_bot

TELEGRAM_BOT_TOKEN=8635759855:AAHJgyPLHISD6b6MOBGWBPZrbcGXkHoFllY
# Pon false para desactivar el bot en desarrollo local
TELEGRAM_BOT_ENABLED=true

# --- CORS ---
# Origenes permitidos, separados por coma. En produccion pon el dominio real.
APP_CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://localhost:5174

# --- Resguardos ---
# Revision diaria de vencimientos, en formato cron de Spring (seg min hora ...).
# VA ENTRECOMILLADO: sin comillas, un shell que cargue este archivo con
# `source` interpreta la linea como el comando "0" y expande los asteriscos a
# los nombres de archivo del directorio.
APP_RESGUARDOS_CRON="0 0 6 * * *"
# Dias de antelacion con los que se avisa de un vencimiento proximo.
APP_RESGUARDOS_DIAS_AVISO=7

# --- Frontend ---
# URL base de la API que consume el navegador.
# Local: http://localhost:8080/api   |   Produccion (tras el reverse proxy): /api
VITE_API_URL=http://localhost:8080/api
